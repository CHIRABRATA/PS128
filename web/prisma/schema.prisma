datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

enum UserRole {
  FARMER
  FIELD_AGENT
  VETERINARIAN
  DISTRICT_AUTHORITY
  ADMIN
}

enum UserStatus {
  PENDING_APPROVAL
  ACTIVE
  REJECTED
}

enum Species {
  COW
  BUFFALO
  SHEEP
  GOAT
  PET
  OTHER
}

enum ReportSource {
  FIELD_AGENT
  FARMER
  IVR
}

enum CaseStatus {
  PENDING_REVIEW
  UNDER_EXAMINATION
  LAB_REFERRAL
  CONFIRMED
  CLOSED_HARMLESS
}

enum VetAction {
  ISOLATE
  TREAT
  MONITOR
  REFER_LAB
  NONE
}

enum AssistanceRequestStatus {
  REQUESTED
  ASSIGNED
  ACCEPTED
  REJECTED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum SampleStatus {
  COLLECTED
  SENT
  RESULT_PENDING
  RESULT_RECEIVED
}

enum ChatMessageRole {
  user
  assistant
}

enum NotificationChannel {
  TELEGRAM
  SMS
  EMAIL
}

enum NotificationStatus {
  PENDING
  SENDING
  SENT
  FAILED
}

model User {
  id                String     @id @default(cuid())
  clerkId           String     @unique
  role              UserRole
  status            UserStatus @default(ACTIVE)
  name              String
  phone             String
  preferredLanguage         String     @default("en")
  telegramChatId            String?
  telegramLinkToken         String?
  telegramLinkTokenCreatedAt DateTime?
  districtId        String?
  blockId           String?
  villageId         String?
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  district District? @relation(fields: [districtId], references: [id], onDelete: SetNull)
  block    Block?    @relation(fields: [blockId], references: [id], onDelete: SetNull)
  village  Village?  @relation(fields: [villageId], references: [id], onDelete: SetNull)

  ownedFarms                 Farm[]                 @relation("FarmOwner")
  assignedFarms              Farm[]                 @relation("FarmAgent")
  createdCases               Case[]                 @relation("CaseCreatedBy")
  reviewedCases              Case[]                 @relation("CaseReviewedBy")
  givenVaccinations          VaccinationRecord[]    @relation("VaccinationAdministeredBy")
  givenTreatments            TreatmentRecord[]      @relation("TreatmentAdministeredBy")
  collectedSamples           Sample[]               @relation("SampleCollectedBy")
  chatConversations          ChatConversation[]
  notificationDeliveries     NotificationDelivery[]
  farmerAssistanceRequests   AssistanceRequest[]    @relation("FarmerAssistanceRequests")
  assignedAssistanceRequests AssistanceRequest[]    @relation("AssistanceAssignedAgent")
  assignedCases              Case[]                 @relation("CaseAssignedVet")
  fieldVisits                FieldVisit[]           @relation("AgentFieldVisits")
  authoredVetReports         VeterinaryReport[]     @relation("VetAuthoredReports")
  appNotifications           InAppNotification[]
  telegramConnection         TelegramConnection?
  telegramLinkTokens         TelegramLinkToken[]
  exportAudits               AuthorityExportAudit[]
  auditLogsAsActor           AuditLog[]             @relation("AuditLogsAsActor")
  auditLogsAsTarget          AuditLog[]             @relation("AuditLogsAsTarget")

  @@index([clerkId])
  @@index([role])
  @@index([status])
  @@index([districtId])
  @@index([blockId])
  @@index([villageId])
}

model District {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  blocks             Block[]
  users              User[]
  assistanceRequests AssistanceRequest[]
  exportAudits       AuthorityExportAudit[]
}

model Block {
  id         String   @id @default(cuid())
  districtId String
  name       String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  district           District            @relation(fields: [districtId], references: [id], onDelete: Cascade)
  villages           Village[]
  users              User[]
  assistanceRequests AssistanceRequest[]

  @@unique([districtId, name])
  @@index([districtId])
}

model Village {
  id        String   @id @default(cuid())
  blockId   String
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  block              Block               @relation(fields: [blockId], references: [id], onDelete: Cascade)
  farms              Farm[]
  users              User[]
  alerts             Alert[]
  assistanceRequests AssistanceRequest[]

  @@unique([blockId, name])
  @@index([blockId])
}

model Farm {
  id                 String              @id @default(cuid())
  villageId          String
  farmerUserId       String?
  fieldAgentUserId   String?
  name               String
  latitude           Float
  longitude          Float
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  village            Village             @relation(fields: [villageId], references: [id], onDelete: Restrict)
  farmerUser         User?               @relation("FarmOwner", fields: [farmerUserId], references: [id], onDelete: SetNull)
  fieldAgentUser     User?               @relation("FarmAgent", fields: [fieldAgentUserId], references: [id], onDelete: SetNull)
  herds              Herd[]
  assistanceRequests AssistanceRequest[]

  @@index([villageId])
  @@index([farmerUserId])
  @@index([fieldAgentUserId])
}

model Herd {
  id        String   @id @default(cuid())
  farmId    String
  species   Species
  name      String   @default("Default Herd")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  farm    Farm     @relation(fields: [farmId], references: [id], onDelete: Cascade)
  animals Animal[]

  @@index([farmId])
}

model Animal {
  id          String   @id @default(cuid())
  herdId      String
  tag         String
  species     Species
  iotDeviceId String?
  breed       String?
  ageMonths   Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  herd               Herd                @relation(fields: [herdId], references: [id], onDelete: Restrict)
  cases              Case[]
  vaccinations       VaccinationRecord[]
  treatments         TreatmentRecord[]
  conversations      ChatConversation[]
  veterinaryReports  VeterinaryReport[]
  assistanceRequests AssistanceRequest[]
  iotDevices         IoTDevice[]
  iotReadings        IoTReading[]

  @@unique([herdId, tag])
  @@index([herdId])
  @@index([iotDeviceId])
}

model Case {
  id                   String       @id @default(cuid())
  caseNumber           String       @unique
  submissionId         String?      @unique
  animalId             String
  createdByUserId      String
  reviewedByUserId     String?
  reportSource         ReportSource
  status               CaseStatus   @default(PENDING_REVIEW)
  symptoms             String[]
  durationDays         Int
  affectedCount        Int          @default(1)
  mortalityCount       Int          @default(0)
  photoUrl             String?
  gpsLat               Float?
  gpsLng               Float?
  iotTelemetry         Json?
  analysisResult       Json?
  visionResult         Json?
  vetDiagnosis         String?
  vetRecommendedAction VetAction?

  vetNotes            String?
  vetFollowUpDate     DateTime?
  followUpCompleted   Boolean            @default(false)
  followUpCompletedAt DateTime?
  assignedVeterinarianUserId String?
  assignedAt                 DateTime?
  assignmentLevel            String?
  reportedAt          DateTime           @default(now())
  reviewedAt          DateTime?
  confirmedAt         DateTime?
  closedAt            DateTime?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  animal                   Animal             @relation(fields: [animalId], references: [id], onDelete: Restrict)
  createdByUser            User               @relation("CaseCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  reviewedByUser           User?              @relation("CaseReviewedBy", fields: [reviewedByUserId], references: [id], onDelete: SetNull)
  assignedVeterinarianUser User?              @relation("CaseAssignedVet", fields: [assignedVeterinarianUserId], references: [id], onDelete: SetNull)
  assistanceRequest        AssistanceRequest?
  fieldVisit               FieldVisit?
  treatments               TreatmentRecord[]
  samples                  Sample[]
  veterinaryReports        VeterinaryReport[]

  @@index([animalId])
  @@index([createdByUserId])
  @@index([assignedVeterinarianUserId])
  @@index([status])
  @@index([reportedAt])
  @@index([reviewedAt])
  @@index([confirmedAt])
  @@index([vetFollowUpDate])
}

model AssistanceRequest {
  id                  String                  @id @default(cuid())
  farmerUserId        String
  animalId            String?
  farmId              String
  villageId           String?
  blockId             String?
  districtId          String?
  reason              String
  status                   AssistanceRequestStatus @default(REQUESTED)
  assignedFieldAgentUserId String?
  assignedAt               DateTime?
  assignmentLevel          String?
  requestedAt              DateTime                @default(now())
  scheduledAt              DateTime?
  notes                    String?
  caseId                   String?                 @unique
  createdAt                DateTime                @default(now())
  updatedAt                DateTime                @updatedAt

  farmerUser             User                    @relation("FarmerAssistanceRequests", fields: [farmerUserId], references: [id], onDelete: Cascade)
  assignedFieldAgentUser User?                   @relation("AssistanceAssignedAgent", fields: [assignedFieldAgentUserId], references: [id], onDelete: SetNull)
  animal                 Animal?                 @relation(fields: [animalId], references: [id], onDelete: SetNull)
  farm                   Farm                    @relation(fields: [farmId], references: [id], onDelete: Restrict)
  village                Village?                @relation(fields: [villageId], references: [id], onDelete: SetNull)
  block                  Block?                  @relation(fields: [blockId], references: [id], onDelete: SetNull)
  district               District?               @relation(fields: [districtId], references: [id], onDelete: SetNull)
  case                   Case?                   @relation(fields: [caseId], references: [id], onDelete: SetNull)
  visit                  FieldVisit?

  @@index([farmerUserId])
  @@index([assignedFieldAgentUserId])
  @@index([villageId])
  @@index([blockId])
  @@index([districtId])
  @@index([status])
}

model FieldVisit {
  id                  String            @id @default(cuid())
  assistanceRequestId String            @unique
  fieldAgentUserId    String
  acceptedAt          DateTime?
  startedAt           DateTime?
  completedAt         DateTime?
  observations        String?
  measurements        Json?
  photos              String[]          @default([])
  notes               String?
  caseId              String?           @unique
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  assistanceRequest   AssistanceRequest @relation(fields: [assistanceRequestId], references: [id], onDelete: Cascade)
  fieldAgentUser      User              @relation("AgentFieldVisits", fields: [fieldAgentUserId], references: [id], onDelete: Restrict)
  case                Case?             @relation(fields: [caseId], references: [id], onDelete: SetNull)

  @@index([fieldAgentUserId])
  @@index([createdAt])
}

model VeterinaryReport {
  id                  String     @id @default(cuid())
  caseId              String
  animalId            String
  vetUserId           String
  diagnosis           String
  action              VetAction
  followUpDate        DateTime?
  followUpCompleted   Boolean    @default(false)
  followUpCompletedAt DateTime?
  followUpNotes       String?
  instructions        String?
  prescription        String?
  notes               String?
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt

  case                Case       @relation(fields: [caseId], references: [id], onDelete: Restrict)
  animal              Animal     @relation(fields: [animalId], references: [id], onDelete: Restrict)
  vetUser             User       @relation("VetAuthoredReports", fields: [vetUserId], references: [id], onDelete: Restrict)

  @@index([caseId])
  @@index([animalId])
  @@index([vetUserId])
  @@index([followUpDate])
  @@index([followUpCompleted])
  @@index([createdAt])
}

model InAppNotification {
  id        String   @id @default(cuid())
  userId    String
  title     String
  message   String
  link      String?
  read      Boolean  @default(false)
  type      String
  createdAt DateTime @default(now())

  user               User                           @relation(fields: [userId], references: [id], onDelete: Cascade)
  telegramDeliveries TelegramNotificationDelivery[]

  @@index([userId])
  @@index([read])
  @@index([createdAt])
}

model VaccinationRecord {
  id                   String    @id @default(cuid())
  animalId             String
  vaccineName          String
  dateGiven            DateTime
  nextDueDate          DateTime?
  administeredByUserId String
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  animal             Animal @relation(fields: [animalId], references: [id], onDelete: Restrict)
  administeredByUser User   @relation("VaccinationAdministeredBy", fields: [administeredByUserId], references: [id], onDelete: Restrict)

  @@index([animalId])
  @@index([administeredByUserId])
}

model TreatmentRecord {
  id                   String   @id @default(cuid())
  animalId             String
  caseId               String?
  medication           String
  dateGiven            DateTime @default(now())
  notes                String?
  administeredByUserId String
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  animal             Animal @relation(fields: [animalId], references: [id], onDelete: Restrict)
  case               Case?  @relation(fields: [caseId], references: [id], onDelete: SetNull)
  administeredByUser User   @relation("TreatmentAdministeredBy", fields: [administeredByUserId], references: [id], onDelete: Restrict)

  @@index([animalId])
  @@index([caseId])
  @@index([administeredByUserId])
}

model Sample {
  id                String       @id @default(cuid())
  caseId            String
  collectedByUserId String
  collectedAt       DateTime     @default(now())
  labName           String?
  sentAt            DateTime?
  resultReceivedAt  DateTime?
  resultSummary     String?
  status            SampleStatus @default(COLLECTED)
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  case            Case @relation(fields: [caseId], references: [id], onDelete: Restrict)
  collectedByUser User @relation("SampleCollectedBy", fields: [collectedByUserId], references: [id], onDelete: Restrict)

  @@index([caseId])
  @@index([collectedByUserId])
}

model Alert {
  id          String    @id @default(cuid())
  villageId   String
  diseaseName String?
  caseCount   Int       @default(1)
  windowStart DateTime
  windowEnd   DateTime
  active      Boolean   @default(true)
  notifiedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  village Village @relation(fields: [villageId], references: [id], onDelete: Restrict)
  notificationDeliveries NotificationDelivery[]

  @@index([villageId])
  @@index([active])
  @@index([windowStart, windowEnd])
}

model NotificationDelivery {
  id           String              @id @default(cuid())
  alertId      String
  userId       String
  channel      NotificationChannel @default(TELEGRAM)
  status       NotificationStatus  @default(PENDING)
  attemptCount Int                 @default(0)
  sentAt       DateTime?
  lastError    String?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  alert Alert @relation(fields: [alertId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([alertId, userId, channel])
  @@index([alertId])
  @@index([userId])
  @@index([status])
}

model ChatConversation {
  id        String   @id @default(cuid())
  animalId  String
  userId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  animal   Animal        @relation(fields: [animalId], references: [id], onDelete: Restrict)
  user     User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages ChatMessage[]

  @@index([animalId])
  @@index([userId])
}

model ChatMessage {
  id             String          @id @default(cuid())
  conversationId String
  role           ChatMessageRole
  content        String
  createdAt      DateTime        @default(now())

  conversation ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@index([createdAt])
}

model TelegramConnection {
  id                     String   @id @default(cuid())
  userId                 String   @unique
  telegramChatId         String   @unique
  telegramUsername       String?
  connectedAt            DateTime @default(now())
  lastVerifiedAt         DateTime?
  isActive               Boolean  @default(true)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  telegramDeliveries TelegramNotificationDelivery[]

  @@index([telegramChatId])
}

model TelegramLinkToken {
  id         String   @id @default(cuid())
  userId     String
  tokenHash  String   @unique
  expiresAt  DateTime
  usedAt     DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model TelegramNotificationDelivery {
  id                    String             @id @default(cuid())
  notificationId        String
  telegramConnectionId  String
  sentAt                DateTime?
  telegramMessageId     Int?
  status                NotificationStatus
  errorMessage          String?

  notification       InAppNotification  @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  telegramConnection TelegramConnection @relation(fields: [telegramConnectionId], references: [id], onDelete: Cascade)

  @@unique([notificationId, telegramConnectionId])
  @@index([notificationId])
  @@index([telegramConnectionId])
}

enum AuthorityReportType {
  CASE_SUMMARY
  VACCINATION_COVERAGE
  OUTBREAK_ALERTS
}

enum ExportFormat {
  CSV
  PDF
}

model AuthorityExportAudit {
  id           String              @id @default(cuid())
  userId       String
  districtId   String
  reportType   AuthorityReportType
  format       ExportFormat
  startDate    DateTime
  endDate      DateTime
  recordCount  Int                 @default(0)
  success      Boolean             @default(true)
  errorMessage String?
  createdAt    DateTime            @default(now())

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  district District @relation(fields: [districtId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([districtId])
  @@index([createdAt])
  @@index([reportType])
}

enum IoTDeviceSource {
  REAL
  SIMULATED
}

enum IoTDeviceStatus {
  ONLINE
  OFFLINE
  SIMULATING
}

model IoTDevice {
  id               String          @id @default(cuid())
  deviceIdentifier String          @unique
  animalId         String?
  source           IoTDeviceSource @default(SIMULATED)
  status           IoTDeviceStatus @default(OFFLINE)
  lastSeenAt       DateTime?
  lastTemperature  Float?
  lastActivity     Int?
  lastAnomalyState Boolean         @default(false)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  animal   Animal?      @relation(fields: [animalId], references: [id], onDelete: SetNull)
  readings IoTReading[]

  @@index([animalId])
  @@index([deviceIdentifier])
  @@index([source])
  @@index([status])
}

model IoTReading {
  id            String          @id @default(cuid())
  deviceId      String
  animalId      String?
  source        IoTDeviceSource @default(SIMULATED)
  temperature   Float
  activityIndex Int
  hasAnomaly    Boolean         @default(false)
  anomalies     String[]        @default([])
  recordedAt    DateTime        @default(now())
  createdAt     DateTime        @default(now())

  device IoTDevice @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  animal Animal?   @relation(fields: [animalId], references: [id], onDelete: SetNull)

  @@index([deviceId])
  @@index([animalId])
  @@index([recordedAt])
  @@index([hasAnomaly])
}

model AuditLog {
  id            String   @id @default(cuid())
  actorUserId   String?
  action        String
  targetUserId  String?
  previousValue String?
  newValue      String?
  reason        String?
  createdAt     DateTime @default(now())

  actorUser     User?    @relation("AuditLogsAsActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  targetUser    User?    @relation("AuditLogsAsTarget", fields: [targetUserId], references: [id], onDelete: SetNull)

  @@index([actorUserId])
  @@index([targetUserId])
  @@index([action])
  @@index([createdAt])
}



